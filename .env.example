# Copy this file to .env and adjust. Never commit .env (it is in .gitignore).
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://gst:gst@localhost:5432/gst_copilot
REDIS_URL=redis://localhost:6379/0

# Embeddings: "fastembed" (local model, downloads ~130 MB on first use) or "fake" (tests only)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunking: "section" (one section/rule per chunk, default) or "fixed" (M1 baseline windows).
# Changing it re-chunks every document on the next ingest.
CHUNKING_STRATEGY=section

# Retrieval: "vector" (default) or "hybrid" (vector + keyword search, fused; experimental).
RETRIEVAL_MODE=vector

# Reranker: "cross-encoder" (default; fastembed model, ~90 MB download on first use),
# "none" (off) or "fake" (tests only). BAAI/bge-reranker-base was tried: worse and 7x slower.
RERANKER=cross-encoder
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# LLM: any OpenAI-compatible API. Leave LLM_BASE_URL empty for retrieval-only mode.
# Local Ollama:  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=<a model you pulled>
# Hosted API:    LLM_BASE_URL=<provider base URL>          LLM_API_KEY=<your key>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Answer length cap (truncated answers are flagged) and optional repetition penalty.
LLM_MAX_TOKENS=512
LLM_FREQUENCY_PENALTY=0
# Prompt version from src/gst_copilot/rag/prompt.py (m2-v3 default, see ADR 0007)
PROMPT_VERSION=m2-v3

# Only for docker compose: how the containers reach an LLM on your laptop, e.g.
# DOCKER_LLM_BASE_URL=http://host.docker.internal:11434/v1
DOCKER_LLM_BASE_URL=
